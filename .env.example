# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/text2sql
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000
DEMO_MODE=false
QUERY_ROW_LIMIT=200
RATE_LIMIT_PER_MINUTE=10

# Real LLM mode. Paste your OpenAI key in your local .env or Render env vars.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama2
LLM_ACCESS_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

